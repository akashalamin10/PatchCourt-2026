# Optional: bake the contract address into a public deployment instead of
# entering it on the Setup page. Read as window.PATCHCOURT_CONTRACT_ADDRESS.
PATCHCOURT_CONTRACT_ADDRESS=

# The network is hardcoded to Studio Next (chain 61997) in
# public/js/config.js -- there is intentionally no env override, so the app
# can't be pointed at a non-hackathon network by accident.
